# sec-agent-squad/infra/Dockerfile.net
# Strictly defensive web/API QA, HTTP header/CSP/TLS compliance & headless Playwright sandbox (gVisor runsc, --read-only, UID 65534)
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    TMPDIR=/tmp \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    PIP_CACHE_DIR=/tmp/.pip

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      ca-certificates curl openssl dnsutils jq tar gzip libatomic1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir playwright httpx schemathesis mitmproxy \
    && playwright install --with-deps chromium \
    && chmod -R a+rX /opt/pw-browsers \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
USER 65534:65534
CMD ["sh", "-c", "echo sec-sandbox-net-ready"]
